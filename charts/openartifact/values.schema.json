{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenArtifact Helm chart values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "volume": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "storageClass": { "type": "string" },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["ReadWriteOnce", "ReadWriteMany", "ReadWriteOncePod", "ReadOnlyMany"] }
        },
        "size": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    }
  },
  "properties": {
    "global": { "type": "object" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": { "type": "string" },
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "replicaCount": { "type": "integer", "minimum": 0 },
    "revisionHistoryLimit": { "type": "integer", "minimum": 0 },
    "updateStrategy": { "type": "object" },
    "baseUrl": { "type": "string", "pattern": "^(|https?://.+)$" },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logLevel": { "enum": ["debug", "info", "warn", "error"] },
        "logFormat": { "enum": ["json", "text"] },
        "allowAnonymousRead": { "type": "boolean" },
        "legacyApiKeyEnabled": { "type": "boolean" },
        "sessionDurationHours": { "type": "integer", "minimum": 1 },
        "corsOrigins": { "type": "array", "items": { "type": "string" } },
        "trustedProxies": { "type": "array", "items": { "type": "string" } },
        "ipAllowlist": { "type": "array", "items": { "type": "string" } },
        "rateLimitRps": { "type": "integer", "minimum": 0 },
        "migrateOnStart": { "type": "boolean" },
        "shutdownTimeout": { "type": "integer", "minimum": 0 },
        "projectsSelfCreate": { "type": "boolean" }
      }
    },
    "env": { "$ref": "#/definitions/stringMap" },
    "extraEnv": { "type": "array" },
    "extraEnvFrom": { "type": "array" },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" },
        "hmacKey": { "type": "string" },
        "encryptionKey": {
          "type": "string",
          "anyOf": [{ "maxLength": 0 }, { "minLength": 16 }]
        },
        "apiKey": { "type": "string" },
        "extra": { "$ref": "#/definitions/stringMap" },
        "keepOnUninstall": { "type": "boolean" }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sslMode": { "enum": ["disable", "allow", "prefer", "require", "verify-ca", "verify-full"] },
        "maxOpenConns": { "type": "integer", "minimum": 1 },
        "maxIdleConns": { "type": "integer", "minimum": 0 },
        "connMaxLifetimeMinutes": { "type": "integer", "minimum": 0 },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "name": { "type": "string" },
            "user": { "type": "string" },
            "password": { "type": "string" },
            "existingSecret": { "type": "string" },
            "existingSecretPasswordKey": { "type": "string" }
          }
        },
        "waitForDatabase": { "type": "boolean" },
        "connectTimeout": { "type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$" }
      }
    },
    "cnpg": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "instances": { "type": "integer", "minimum": 1 },
        "imageName": { "type": "string" },
        "database": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": { "type": "string" },
            "storageClass": { "type": "string" }
          }
        },
        "resources": { "type": "object" },
        "enablePodMonitor": { "type": "boolean" },
        "extraSpec": { "type": "object" }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["filesystem", "s3", "garage", "seaweedfs", "gcs", "azure", "oci"] },
        "path": { "type": "string", "pattern": "^/" },
        "bucket": { "type": "string" },
        "region": { "type": "string" },
        "endpoint": { "type": "string" },
        "forcePathStyle": { "type": "boolean" },
        "presignTtl": { "type": "string" },
        "gcs": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "bucket": { "type": "string" } }
        },
        "azure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accountName": { "type": "string" },
            "containerName": { "type": "string" }
          }
        },
        "oci": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "insecure": { "type": "boolean" } }
        },
        "credentials": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": { "type": "string" },
            "accessKey": { "type": "string" },
            "secretKey": { "type": "string" },
            "gcsHmacKey": { "type": "string" },
            "gcsHmacSecret": { "type": "string" },
            "azureAccountKey": { "type": "string" },
            "ociUsername": { "type": "string" },
            "ociPassword": { "type": "string" }
          }
        }
      }
    },
    "persistence": { "$ref": "#/definitions/volume" },
    "backups": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "leaseTtl": {"type": "string", "pattern": "^(|[0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h)([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))*)$"},
        "persistence": { "$ref": "#/definitions/volume" }
      }
    },
    "gpg": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "existingSecret": { "type": "string" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "authToken": { "type": "string" },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "type": "string" },
            "scrapeTimeout": { "type": "string" },
            "labels": { "type": "object" }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["host", "paths"],
            "properties": {
              "host": { "type": "string" },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["path", "pathType"],
                  "properties": {
                    "path": { "type": "string" },
                    "pathType": { "enum": ["Prefix", "Exact", "ImplementationSpecific"] }
                  }
                }
              }
            }
          }
        },
        "tls": { "type": "array" }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "annotations": { "type": "object" },
        "parentRefs": { "type": "array" },
        "hostnames": { "type": "array", "items": { "type": "string" } },
        "rules": { "type": "array", "items": { "type": "object" } }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "resources": { "type": "object" },
    "startupProbe": { "type": "object" },
    "livenessProbe": { "type": "object" },
    "readinessProbe": { "type": "object" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": ["integer", "string"] },
        "targetMemoryUtilizationPercentage": { "type": ["integer", "string"] }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "maxUnavailable": { "type": ["integer", "string"] }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "from": { "type": "array" },
      "egress": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "dns": {
            "type": "boolean"
          },
          "otlp": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "to": {
                "type": "array"
              },
              "port": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 65535
              }
            }
          },
          "scanners": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "to": {
                "type": "array"
              },
              "ports": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            }
          },
          "extra": {
            "type": "array"
          }
        }
      }
      }
    },
    "dockerUploads": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dir": {
          "type": "string",
          "pattern": "^(|/.+)$"
        },
        "ttl": {
          "type": "string",
          "pattern": "^(|[0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h)([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))*)$"
        },
        "sizeLimit": {
          "type": "string",
          "pattern": "^(|[0-9]+(\\.[0-9]+)?(Ei|Pi|Ti|Gi|Mi|Ki|E|P|T|G|M|k|m)?)$"
        },
        "persistence": {
          "$ref": "#/definitions/volume"
        }
      }
    },
    "tmp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sizeLimit": {
          "type": "string",
          "pattern": "^(|[0-9]+(\\.[0-9]+)?(Ei|Pi|Ti|Gi|Mi|Ki|E|P|T|G|M|k|m)?)$"
        },
        "medium": {
          "enum": [
            "",
            "Memory"
          ]
        }
      }
    },
    "blobDeletion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "grace": {
          "type": "string",
          "pattern": "^(|[0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h)([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))*)$"
        },
        "sweepInterval": {
          "type": "string",
          "pattern": "^(|[0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h)([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))*)$"
        },
        "sweepBatch": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "tiering": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "interval": {
          "type": "string",
          "pattern": "^(|[0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h)([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))*)$"
        },
        "batch": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "concurrency": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "maxBytesPerSecond": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "verifyReadback": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "accessFlushInterval": {
          "type": "string",
          "pattern": "^(|[0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h)([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))*)$"
        },
        "refreshInterval": {
          "type": "string",
          "pattern": "^(|[0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h)([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))*)$"
        }
      }
    },
    "scanners": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cache": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/.+"
            },
            "sizeLimit": {
              "type": "string",
              "pattern": "^(|[0-9]+(\\.[0-9]+)?(Ei|Pi|Ti|Gi|Mi|Ki|E|P|T|G|M|k|m)?)$"
            },
            "persistence": {
              "$ref": "#/definitions/volume"
            }
          }
        },
        "offline": {
          "type": "boolean"
        },
        "updateInterval": {
          "type": "string",
          "pattern": "^(|[0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h)([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))*)$"
        },
        "downloadBaseUrl": {
          "type": "string",
          "pattern": "^(|https://[^/@?#]+[^@?#]*)$"
        },
        "trivy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "install": {
              "enum": [
                "none",
                "auto"
              ]
            },
            "path": {
              "type": "string"
            },
            "dbRepository": {
              "type": "string"
            },
            "javaDbRepository": {
              "type": "string"
            }
          }
        },
        "grype": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "install": {
              "enum": [
                "none",
                "auto"
              ]
            },
            "path": {
              "type": "string"
            },
            "dbUrl": {
              "type": "string",
              "pattern": "^(|https?://.+)$"
            }
          }
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "otlp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "endpoint": {
              "type": "string"
            },
            "protocol": {
              "enum": [
                "",
                "grpc",
                "http",
                "http/protobuf"
              ]
            },
            "insecure": {
              "type": "boolean"
            },
            "serviceName": {
              "type": "string"
            },
            "sampleRatio": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "metrics": {
              "type": "boolean"
            },
            "headersExistingSecret": {
              "type": "string"
            },
            "headersSecretKey": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array" },
    "priorityClassName": { "type": "string" },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" },
    "extraInitContainers": { "type": "array" }
  }
}
